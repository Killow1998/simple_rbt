<?xml version="1.0"?>
<launch>
    <arg name="sensor_namespace" default="limo"/>
    <!-- Limo Ackermann with Front Camera & IMU -->
    <param name="robot_description" command="$(find xacro)/xacro '$(find simple_rbt)/model/limo/limo_with_front_cam_imu.xacro'
        sensor_namespace:=$(arg sensor_namespace)" />

    <arg name="x" default="0.0"/>
    <arg name="y" default="0.0"/>
    <arg name="z" default="0.16"/>
    <arg name="yaw" default="0.0"/>

    <node name="spawn_limo_model" pkg="gazebo_ros" type="spawn_model" args="-x $(arg x)
        -y $(arg y)
        -z $(arg z)
        -Y $(arg yaw)
        -unpause
        -urdf
        -param robot_description
        -model limo" />

    <rosparam file="$(find simple_rbt)/config/limo_ackerman_control.yaml" command="load"/>

    <node name="controller_spawner" pkg="controller_manager" type="spawner" 
        respawn="false" output="screen" args="limo_state_controller  
            limo_fl_steering_hinge_controller limo_fr_steering_hinge_controller"/>

    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
    <node name="dummy_zero_cmd_vel" pkg="simple_rbt" type="dummy_cmd_vel" />

    <node name="battery_state_publisher" pkg="simple_rbt" type="static_battery_pub.py" ns="$(arg sensor_namespace)" output="screen">
        <param name="frame_id" type="string" value="base_link" />
    </node>
</launch>
