<?xml version="1.0"?>
<launch>
    <arg name="sensor_namespace" default="omni"/>
    <!-- Omni Robot with Mid360 -->
    <param name="robot_description" command="$(find xacro)/xacro '$(find simple_rbt)/model/omni/omni_with_mid360.xacro'
        sensor_namespace:=$(arg sensor_namespace) robot_namespace:=$(arg sensor_namespace)" />

    <arg name="x" default="0.0"/>
    <arg name="y" default="0.0"/>
    <arg name="z" default="0.16"/>
    <arg name="yaw" default="0.0"/>

    <node name="spawn_omni_model" pkg="gazebo_ros" type="spawn_model" args="-x $(arg x)
        -y $(arg y)
        -z $(arg z)
        -Y $(arg yaw)
        -unpause
        -urdf
        -param robot_description
        -model omni" />

    <rosparam file="$(find simple_rbt)/config/omni_control.yaml" command="load" ns="$(arg sensor_namespace)"/>

    <node name="controller_spawner" pkg="controller_manager" type="spawner" ns="$(arg sensor_namespace)" 
        respawn="false" output="screen" args="joint_state_controller first_wheel_controller second_wheel_controller third_wheel_controller"/>

    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
    
    <!-- Omni Commander to convert cmd_vel to wheel velocities -->
    <node name="omni_commander" pkg="simple_rbt" type="omni_commander.py" output="screen">
        <remap from="/cmd_vel" to="/$(arg sensor_namespace)/cmd_vel"/>
        <remap from="/first_wheel_controller/command" to="/$(arg sensor_namespace)/first_wheel_controller/command"/>
        <remap from="/second_wheel_controller/command" to="/$(arg sensor_namespace)/second_wheel_controller/command"/>
        <remap from="/third_wheel_controller/command" to="/$(arg sensor_namespace)/third_wheel_controller/command"/>
    </node>


    <node name="battery_state_publisher" pkg="simple_rbt" type="static_battery_pub.py" ns="$(arg sensor_namespace)" output="screen">
        <param name="frame_id" type="string" value="base_link" />
    </node>
</launch>
