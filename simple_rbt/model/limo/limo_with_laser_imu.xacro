<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="limo_with_laser_imu">
  <xacro:arg name="sensor_namespace" default="limo"/>
  <xacro:include filename="$(find simple_rbt)/model/limo/urdf/limo_ackerman.xacro"/>
  <xacro:include filename="$(find simple_rbt)/model/sensor/simple_laser_imu/model.xacro"/>
  <xacro:simple_laser_imu parent_link="base_link" xyz="0.0 0.0 0.05" rpy="0 0 0" sensor_namespace="$(arg sensor_namespace)" />
</robot>
