        0,
        0
      ]
    },
    "camera": {
      "position": [
        0.25,
        0,
        0.14
      ],
      "quaternion": [
        1,
        0,
        0,
        0
      ]
    }
  },
  "sensors": {
    "mid360": true,
    "camera": true,
    "depth": true,
    "panorama": false
