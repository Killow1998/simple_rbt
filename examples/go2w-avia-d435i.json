{
  "robot": "go2w",
  "controller": "rl_sar",
  "control_mode": "tracked",
  "terrain": "flat",
  "terrain_level": "standard",
  "backend": "cpu",
  "camera_hz": 10,
  "camera_model": "d435i",
  "lidar_model": "avia",
