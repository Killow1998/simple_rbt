+// LCD coverage is not a color glyph: the renderer must still tint normal
+// text. The Pango face's LCD options can survive a Cairo scaled-font clone
+// that reports grayscale antialiasing, including on transparent surfaces.
+func TestPangoTextTintWithSubpixelAntialiasing(t *testing.T) {
+	for _, antialias := range []string{"gray", "subpixel"} {
+		for _, opaque := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/opaque=%v", antialias, opaque), func(t *testing.T) {
+				s := newSystem()
+				s.SetFontRendering(antialias, "slight", "rgb")
+				layout := s.Layout(Params{Text: "SpRobo 中文", Style: Style{Family: "sans-serif", Size: 14}})
+				e := s.engine().(*pangoEngine)
+				checked := 0
+				for _, line := range layout.Lines {
+					for _, glyph := range line.Glyphs {
+						b := e.glyph(glyph.Font, glyph.ID, 1, 0, 0, opaque)
+						if b.pix == nil {
+							continue
+						}
+						checked++
+						if b.color {
+							t.Fatal("normal text became a color glyph and would ignore its text color")
+						}
+						if want := antialias == "subpixel" && opaque; b.subpixel != want {
+							t.Fatalf("subpixel coverage = %v, want %v", b.subpixel, want)
+						}
+					}
+				}
+				if checked < 6 {
+					t.Fatalf("only %d visible glyphs were checked", checked)
+				}
+			})
+		}
+	}
+}
+
+func TestPangoColorEmojiRetainsItsColors(t *testing.T) {
+	s := newSystem()
+	s.SetFontRendering("subpixel", "slight", "rgb")
+	layout := s.Layout(Params{Text: "😀", Style: Style{Family: "Noto Color Emoji", Size: 20}})
+	e := s.engine().(*pangoEngine)
+	checked := 0
+	for _, line := range layout.Lines {
+		for _, glyph := range line.Glyphs {
+			var colorFont int32
+			if pangoLib.fcPatternGetBool == nil || pangoLib.fcPatternGetBool(pangoLib.fontGetPattern(glyph.Font.native), "color", 0, &colorFont) != fcResultMatch || colorFont == 0 {
+				t.Skip("no color emoji font installed")
+			}
+			b := e.glyph(glyph.Font, glyph.ID, 1, 0, 0, true)
+			if b.pix == nil || !b.color || b.subpixel {
+				t.Fatal("color emoji lost its original colors")
+			}
+			checked++
+		}
+	}
+	if checked == 0 {
+		t.Fatal("no emoji glyph was checked")
+	}
+}
